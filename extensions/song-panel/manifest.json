{
  "$schema": "../../schemas/manifest.schema.json",
  "id": "song-panel",
  "name": "Song panel",
  "version": "1.4.0",
  "kind": "extension",
  "author": "Shirowwww",
  "description": "A button of the playback bar that slides in a column about the song playing: a large cover, the lyrics lit word by word, its tempo, key and mood, the album with its year and genre, the artist, the credits and what comes next.",
  "translations": {"fr": {"name": "Panneau du morceau", "description": "Un bouton de la barre de lecture qui fait glisser une colonne sur le morceau en cours : une grande pochette, les paroles qui s'allument mot par mot, son tempo, sa tonalité et son humeur, l'album avec son année et son genre, l'artiste, les crédits et la suite de la file.", "settings": {"lyrics": "Paroles", "artist": "À propos de l'artiste", "credits": "Crédits", "queue": "À suivre", "colour": "Fond", "sound": "Le son", "sound-tempo": "Le son : tempo", "sound-key": "Le son : tonalité", "sound-mood": "Le son : humeur", "sound-energy": "Le son : énergie", "sound-dance": "Le son : dansant", "sound-acoustic": "Le son : acoustique", "sound-vocals": "Le son : chant", "sound-loudness": "Le son : niveau sonore"}, "options": {"Artwork": "Couleurs de la pochette", "Theme": "Celui du thème"}}, "de": {"name": "Titelleiste", "description": "Eine Taste in der Wiedergabeleiste, die eine Spalte zum laufenden Titel hereinschiebt: großes Cover, Songtext Wort für Wort, das Album mit Jahr und Genre, der Künstler, die Mitwirkenden und was als Nächstes kommt.", "settings": {"lyrics": "Songtext", "artist": "Über den Künstler", "credits": "Mitwirkende", "queue": "Als Nächstes", "colour": "Hintergrund", "sound": "Der Klang", "sound-tempo": "Der Klang: Tempo", "sound-key": "Der Klang: Tonart", "sound-mood": "Der Klang: Stimmung", "sound-energy": "Der Klang: Energie", "sound-dance": "Der Klang: Tanzbarkeit", "sound-acoustic": "Der Klang: akustisch", "sound-vocals": "Der Klang: Gesang", "sound-loudness": "Der Klang: Lautheit"}, "options": {"Artwork": "Farben des Covers", "Theme": "Wie das Theme"}}, "es": {"name": "Panel de la canción", "description": "Un botón de la barra de reproducción que desliza una columna sobre la canción que suena: una portada grande, la letra iluminada palabra por palabra, el álbum con su año y género, el artista, los créditos y lo que viene después.", "settings": {"lyrics": "Letra", "artist": "Sobre el artista", "credits": "Créditos", "queue": "A continuación", "colour": "Fondo", "sound": "El sonido", "sound-tempo": "El sonido: tempo", "sound-key": "El sonido: tonalidad", "sound-mood": "El sonido: ánimo", "sound-energy": "El sonido: energía", "sound-dance": "El sonido: bailable", "sound-acoustic": "El sonido: acústico", "sound-vocals": "El sonido: voz", "sound-loudness": "El sonido: sonoridad"}, "options": {"Artwork": "Colores de la carátula", "Theme": "El del tema"}}, "pt": {"name": "Painel da música", "description": "Um botão da barra de reprodução que desliza uma coluna sobre a música que está tocando: capa grande, letra acesa palavra por palavra, o álbum com ano e gênero, o artista, os créditos e o que vem a seguir.", "settings": {"lyrics": "Letra", "artist": "Sobre o artista", "credits": "Créditos", "queue": "A seguir", "colour": "Fundo", "sound": "O som", "sound-tempo": "O som: andamento", "sound-key": "O som: tom", "sound-mood": "O som: clima", "sound-energy": "O som: energia", "sound-dance": "O som: dançante", "sound-acoustic": "O som: acústico", "sound-vocals": "O som: voz", "sound-loudness": "O som: intensidade"}, "options": {"Artwork": "Cores da capa", "Theme": "O do tema"}}, "ru": {"name": "Панель песни", "description": "Кнопка на панели воспроизведения выдвигает колонку о текущей песне: большая обложка, текст, подсвечиваемый по словам, альбом с годом и жанром, исполнитель, авторы и что будет дальше.", "settings": {"lyrics": "Текст", "artist": "Об исполнителе", "credits": "Авторы", "queue": "Далее", "colour": "Фон", "sound": "Звучание", "sound-tempo": "Звучание: темп", "sound-key": "Звучание: тональность", "sound-mood": "Звучание: настроение", "sound-energy": "Звучание: энергия", "sound-dance": "Звучание: танцевальность", "sound-acoustic": "Звучание: акустичность", "sound-vocals": "Звучание: вокал", "sound-loudness": "Звучание: громкость"}, "options": {"Artwork": "Цвета обложки", "Theme": "Как в теме"}}, "ja": {"name": "曲パネル", "description": "再生バーのボタンで、再生中の曲の列がスライドして開きます。大きなアートワーク、単語ごとに光る歌詞、年とジャンル付きのアルバム、アーティスト、クレジット、次に再生される曲。", "settings": {"lyrics": "歌詞", "artist": "アーティストについて", "credits": "クレジット", "queue": "次に再生", "colour": "背景", "sound": "サウンド", "sound-tempo": "サウンド：テンポ", "sound-key": "サウンド：キー", "sound-mood": "サウンド：ムード", "sound-energy": "サウンド：エネルギー", "sound-dance": "サウンド：ダンス度", "sound-acoustic": "サウンド：アコースティック", "sound-vocals": "サウンド：ボーカル", "sound-loudness": "サウンド：ラウドネス"}, "options": {"Artwork": "アートワークの色", "Theme": "テーマのまま"}}, "zh": {"name": "歌曲面板", "description": "播放栏上的一个按钮，滑出一列显示正在播放的歌曲：大封面、逐字点亮的歌词、带年份和流派的专辑、艺人、制作人员以及接下来播放的内容。", "settings": {"lyrics": "歌词", "artist": "关于艺人", "credits": "制作人员", "queue": "接下来播放", "colour": "背景", "sound": "声音", "sound-tempo": "声音：速度", "sound-key": "声音：调性", "sound-mood": "声音：情绪", "sound-energy": "声音：能量", "sound-dance": "声音：舞曲感", "sound-acoustic": "声音：原声度", "sound-vocals": "声音：人声", "sound-loudness": "声音：响度"}, "options": {"Artwork": "封面颜色", "Theme": "跟随主题"}}, "it": {"name": "Pannello del brano", "description": "Un pulsante della barra di riproduzione che fa scorrere una colonna sul brano in riproduzione: una grande copertina, i testi illuminati parola per parola, l'album con anno e genere, l'artista, i crediti e cosa viene dopo.", "settings": {"lyrics": "Testi", "artist": "Info sull'artista", "credits": "Crediti", "queue": "Prossimi in coda", "colour": "Sfondo", "sound": "Il suono", "sound-tempo": "Il suono: tempo", "sound-key": "Il suono: tonalità", "sound-mood": "Il suono: umore", "sound-energy": "Il suono: energia", "sound-dance": "Il suono: ballabilità", "sound-acoustic": "Il suono: acustico", "sound-vocals": "Il suono: voce", "sound-loudness": "Il suono: intensità"}, "options": {"Artwork": "Colori della copertina", "Theme": "Quello del tema"}}, "ko": {"name": "곡 패널", "description": "재생 바의 버튼으로, 재생 중인 곡에 대한 열을 옆에서 밀어 넣습니다. 큰 커버, 단어별로 밝아지는 가사, 연도와 장르가 있는 앨범, 아티스트, 크레딧, 다음 곡이 나옵니다.", "settings": {"lyrics": "가사", "artist": "아티스트 정보", "credits": "크레딧", "queue": "다음 곡", "colour": "배경", "sound": "사운드", "sound-tempo": "사운드: 템포", "sound-key": "사운드: 조성", "sound-mood": "사운드: 분위기", "sound-energy": "사운드: 에너지", "sound-dance": "사운드: 댄스 지수", "sound-acoustic": "사운드: 어쿠스틱", "sound-vocals": "사운드: 보컬", "sound-loudness": "사운드: 음량"}, "options": {"Artwork": "커버 색상", "Theme": "테마 그대로"}}},
  "kitApi": "1.0",
  "minAmpify": "1.3.0",
  "preview": "preview.jpg",
  "main": "main.js",
  "permissions": ["ui.panel", "ui.playbar", "ui.window", "player.read", "player.control", "library.read", "storage"],
  "settings": [
    {"key": "lyrics", "label": "Lyrics", "type": "toggle", "default": true},
    {"key": "sound", "label": "The sound", "type": "toggle", "default": true},
    {"key": "sound-tempo", "label": "The sound: tempo", "type": "toggle", "default": true},
    {"key": "sound-key", "label": "The sound: key", "type": "toggle", "default": true},
    {"key": "sound-mood", "label": "The sound: mood", "type": "toggle", "default": true},
    {"key": "sound-energy", "label": "The sound: energy", "type": "toggle", "default": true},
    {"key": "sound-dance", "label": "The sound: danceability", "type": "toggle", "default": false},
    {"key": "sound-acoustic", "label": "The sound: acoustic", "type": "toggle", "default": false},
    {"key": "sound-vocals", "label": "The sound: vocals", "type": "toggle", "default": false},
    {"key": "sound-loudness", "label": "The sound: loudness", "type": "toggle", "default": false},
    {"key": "artist", "label": "About the artist", "type": "toggle", "default": true},
    {"key": "credits", "label": "Credits", "type": "toggle", "default": true},
    {"key": "queue", "label": "Next in queue", "type": "toggle", "default": true},
    {"key": "colour", "label": "Background", "type": "choice", "options": ["Artwork", "Theme"], "default": "Artwork"}
  ]
}
