{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Community catalog of extensions, themes, apps and snippets",
  "description": "Public list of installable items. Each entry points to an archive with a pinned SHA-256. See docs/extensions/catalog.md.",
  "type": "object",
  "required": ["catalogVersion", "extensions"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "catalogVersion": {"type": "integer", "const": 1},
    "versions": {
      "type": "object",
      "required": ["url", "sha256"],
      "additionalProperties": false,
      "description": "Where the list of tested Apple Music versions is published (versions.json in ampify-catalog), and its SHA-256. Read by ampify versions update.",
      "properties": {
        "url": {"$ref": "#/$defs/https"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "extensions": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "name", "version", "kind", "author", "description", "kitApi", "url", "sha256"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,39}$",
          "description": "Id of the item. Unique in the catalog."
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 60},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "kind": {"$ref": "#/$defs/kind"},
        "author": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
          "description": "GitHub login of the author."
        },
        "description": {"type": "string", "minLength": 1, "maxLength": 300},
        "translations": {"$ref": "#/$defs/translations"},
        "kitApi": {"$ref": "#/$defs/kitApi"},
        "url": {
          "$ref": "#/$defs/https",
          "description": "Zip archive containing the item's folder, with its manifest.json."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 hash of the archive, in lowercase. Any archive that does not match is refused."
        },
        "homepage": {"$ref": "#/$defs/https"},
        "license": {"type": "string", "minLength": 1, "maxLength": 64},
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 5,
          "description": "Copy of the manifest's tags, shown on the Marketplace card.",
          "items": {"$ref": "#/$defs/tag"}
        },
        "preview": {
          "type": "string",
          "pattern": "^https://[^\\s]+\\.(png|jpg|jpeg)$",
          "maxLength": 512,
          "description": "Preview image shown on the Marketplace card. The page loads it only from the host of the catalog or of the archive url."
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "description": "Copy of the manifest's permissions, shown to the user before the item is turned on. Never kit.manage: only Ampify's own Marketplace holds it.",
          "items": {"$ref": "#/$defs/permission"}
        }
      }
    },
    "kind": {"enum": ["extension", "theme", "app", "snippet"]},
    "translations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Copy of the manifest's translations (fr, de, es, pt, ru, ja, zh), shown when Windows is in that language.",
      "properties": {
        "fr": {"$ref": "#/$defs/translation"},
        "de": {"$ref": "#/$defs/translation"},
        "es": {"$ref": "#/$defs/translation"},
        "pt": {"$ref": "#/$defs/translation"},
        "ru": {"$ref": "#/$defs/translation"},
        "ja": {"$ref": "#/$defs/translation"},
        "zh": {"$ref": "#/$defs/translation"}
      }
    },
    "translation": {
      "type": "object",
      "required": ["name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 60},
        "description": {"type": "string", "minLength": 1, "maxLength": 300},
        "settings": {"type": "object", "description": "The label of each declared setting, by its key.", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 60}},
        "options": {"type": "object", "description": "The text of each option of a choice setting, by its stored value.", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 60}},
        "groups": {"type": "object", "description": "The heading of each group of settings, by its name.", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 40}},
        "settingDescriptions": {"type": "object", "description": "The description of each setting, by its key.", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 200}}
      }
    },
    "kitApi": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "tag": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,19}$"},
    "https": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 512},
    "permission": {
      "type": "string",
      "pattern": "^(player\\.read|player\\.control|audio\\.analyze|audio\\.gain|audio\\.eq|storage|notifications|ipc\\.discord|midi\\.input|library\\.read|library\\.write|services\\.read|ui\\.keyboard|ui\\.topbar|ui\\.playbar|ui\\.sidebar|ui\\.menu|ui\\.popup|ui\\.fullscreen|ui\\.panel|ui\\.page|ui\\.window|ui\\.tray|fs\\.output|clipboard\\.read|clipboard\\.write|network:[a-z0-9.-]{1,253})$"
    }
  }
}
