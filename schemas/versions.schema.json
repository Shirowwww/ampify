{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apple Music versions tested with Ampify",
  "description": "Published with the catalog. ampify versions update downloads it (SHA-256 pinned in catalog.json) and writes versions.txt in the Ampify folder. The kernel accepts these versions on top of its built-in list, and always checks the exports of AVFoundationCF.dll at launch.",
  "type": "object",
  "required": ["versionsFormat", "playerDll", "versions"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "versionsFormat": {"type": "integer", "const": 1},
    "playerDll": {
      "type": "string",
      "const": "AVFoundationCF.dll",
      "description": "DLL of the package whose exports were checked."
    },
    "versions": {
      "type": "array",
      "items": {"$ref": "#/$defs/version"}
    }
  },
  "$defs": {
    "version": {
      "type": "object",
      "required": ["version", "tested", "exports"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]{1,9}\\.[0-9]{1,9}\\.[0-9]{1,9}\\.[0-9]{1,9}$",
          "description": "Package version, as in AppleInc.AppleMusicWin_<version>_x64__nzyj5cx40ttqa."
        },
        "tested": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Test date, YYYY-MM-DD."
        },
        "exports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 64,
          "description": "Exports of AVFoundationCF.dll checked as present in this version. They must cover the ones Ampify needs (src/core/build_signature.hpp).",
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128}
        },
        "notes": {"type": "string", "maxLength": 300}
      }
    }
  }
}
