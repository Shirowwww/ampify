{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest of an extension, theme, app or snippet",
  "description": "The manifest.json file at the root of the item's folder. The rules specific to each kind (required main file, folder name, files present) are checked by tools/validate.py. See docs/extensions/manifest.md.",
  "type": "object",
  "required": ["id", "name", "version", "kind", "author", "description", "kitApi"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$",
      "description": "Stable id, in lowercase. Must be the folder name."
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 60},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "kind": {"$ref": "#/$defs/kind"},
    "author": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
      "description": "GitHub login of the author."
    },
    "description": {"type": "string", "minLength": 1, "maxLength": 300},
    "kitApi": {"$ref": "#/$defs/kitApi"},
    "homepage": {"$ref": "#/$defs/https"},
    "license": {"type": "string", "minLength": 1, "maxLength": 64},
    "main": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}\\.js$",
      "description": "Main script, at the root of the folder. Required for an extension and an app."
    },
    "type": {
      "enum": ["script", "module"],
      "description": "How main is run: classic script (default) or ES module, which can import the .js and .mjs files of its folder with a relative path."
    },
    "colors": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}\\.ini$",
      "description": "File of the color schemes, for a theme."
    },
    "defaultScheme": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "Name of the colors.ini section used by default."
    },
    "resources": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}\\.xaml$",
      "description": "XAML resource dictionary, for a theme or a snippet."
    },
    "icon": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}\\.svg$",
      "description": "SVG icon for the sidebar, for an app."
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/permission"}
    },
    "processes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 2,
      "description": "Process where the item runs: ui (AppleMusic.exe), engine (AMPLibraryAgent.exe). Both by default.",
      "items": {"enum": ["ui", "engine"]}
    },
    "appVersions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "description": "Apple Music versions the item is tested on. The kernel also applies its own list.",
      "items": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}$"}
    }
  },
  "$defs": {
    "kind": {"enum": ["extension", "theme", "app", "snippet"]},
    "kitApi": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "https": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 512},
    "permission": {
      "type": "string",
      "pattern": "^(player\\.read|player\\.control|audio\\.analyze|audio\\.gain|audio\\.eq|storage|notifications|ipc\\.discord|midi\\.input|library\\.read|library\\.write|services\\.read|ui\\.keyboard|ui\\.topbar|ui\\.playbar|ui\\.sidebar|ui\\.menu|ui\\.popup|ui\\.fullscreen|ui\\.panel|ui\\.page|ui\\.window|ui\\.tray|fs\\.output|kit\\.manage|network:[a-z0-9.-]{1,253})$"
    }
  }
}
