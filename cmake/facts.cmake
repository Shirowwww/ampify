# Reads facts/release.json and facts/apple.json and writes release_facts.hpp and apple_facts.hpp into the build folder,
# the only place C++ reads them from. configure_file leaves a header untouched when its text is the same, so a new
# Apple build does not rebuild what reads only the release facts, and the reverse.

set(AMPIFY_FACTS_DIR "${CMAKE_CURRENT_SOURCE_DIR}/facts")
set(AMPIFY_FACTS_INCLUDE "${CMAKE_CURRENT_BINARY_DIR}/facts")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
             "${AMPIFY_FACTS_DIR}/release.json" "${AMPIFY_FACTS_DIR}/apple.json")

# One text value of a facts file. It goes into a C++ string literal as is, so a quote or a backslash is refused.
function(ampify_fact out json)
    string(JSON value GET "${json}" ${ARGN})
    if(value MATCHES "[\"\\\\]" OR value STREQUAL "")
        string(REPLACE ";" "." where "${ARGN}")
        message(FATAL_ERROR "facts: ${where} must be a non-empty text without quotes or backslashes")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(ampify_fact_bool out json)
    string(JSON value GET "${json}" ${ARGN})
    if(value STREQUAL "ON")
        set(${out} true PARENT_SCOPE)
    elseif(value STREQUAL "OFF")
        set(${out} false PARENT_SCOPE)
    else()
        string(REPLACE ";" "." where "${ARGN}")
        message(FATAL_ERROR "facts: ${where} must be true or false")
    endif()
endfunction()

# The items of a list of texts as C++ literals: "a", "b".
function(ampify_fact_list out json)
    string(JSON count LENGTH "${json}" ${ARGN})
    set(items "")
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        ampify_fact(item "${json}" ${ARGN} ${index})
        list(APPEND items "\"${item}\"")
    endforeach()
    list(JOIN items ", " items)
    set(${out} "${items}" PARENT_SCOPE)
endfunction()

function(ampify_release_elements out json)
    string(JSON count LENGTH "${json}" elements)
    set(rows "")
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        foreach(field id kind folder)
            ampify_fact(${field} "${json}" elements ${index} ${field})
        endforeach()
        foreach(field startsOn firstParty builtIn catalog)
            ampify_fact_bool(${field} "${json}" elements ${index} ${field})
        endforeach()
        string(APPEND rows
            "    {\"${kind}\", \"${folder}\", \"${id}\", ${startsOn}, ${firstParty}, ${builtIn}, ${catalog}},\n")
    endforeach()
    set(${out} "${rows}" PARENT_SCOPE)
endfunction()

function(ampify_release_languages codes line comma json)
    string(JSON count LENGTH "${json}" languages)
    set(all "")
    set(words "")
    set(decimal "")
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        ampify_fact(code "${json}" languages ${index} code)
        ampify_fact_bool(uses "${json}" languages ${index} decimalComma)
        list(APPEND all "\"${code}\"")
        list(APPEND words "${code}")
        if(uses)
            list(APPEND decimal "\"${code}\"")
        endif()
    endforeach()
    list(JOIN all ", " all)
    list(JOIN words ", " words)
    list(JOIN decimal ", " decimal)
    set(${codes} "${all}" PARENT_SCOPE)
    set(${line} "${words}" PARENT_SCOPE)
    set(${comma} "${decimal}" PARENT_SCOPE)
endfunction()

function(ampify_write_release_facts)
    file(READ "${AMPIFY_FACTS_DIR}/release.json" json)
    ampify_fact(AMPIFY_KIT_API "${json}" kitApi)
    if(NOT AMPIFY_KIT_API MATCHES "^([0-9]+)\\.[0-9]+$")
        message(FATAL_ERROR "facts: kitApi must be MAJOR.MINOR, not ${AMPIFY_KIT_API}")
    endif()
    set(AMPIFY_KIT_API_MAJOR "${CMAKE_MATCH_1}")
    ampify_fact(AMPIFY_KIT_FOLDER "${json}" kitFolder)
    foreach(file launcher kernel setup cli)
        ampify_fact(AMPIFY_FILE_${file} "${json}" files ${file})
    endforeach()
    foreach(part prefix suffix checksums)
        ampify_fact(AMPIFY_PACKAGE_${part} "${json}" package ${part})
    endforeach()
    foreach(part owner repository catalogRepository releaseApi catalogUrl site)
        ampify_fact(AMPIFY_PROJECT_${part} "${json}" project ${part})
    endforeach()
    ampify_release_elements(AMPIFY_KIT_ELEMENTS "${json}")
    ampify_release_languages(AMPIFY_LANGUAGES AMPIFY_LANGUAGE_LINE AMPIFY_DECIMAL_COMMA "${json}")
    configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/release_facts.hpp.in" "${AMPIFY_FACTS_INCLUDE}/release_facts.hpp" @ONLY)
    # The version resource of every binary (cmake/version.rc.in) names the project and its owner.
    set(AMPIFY_PROJECT_OWNER "${AMPIFY_PROJECT_owner}" PARENT_SCOPE)
    set(AMPIFY_PROJECT_PAGE "https://github.com/${AMPIFY_PROJECT_repository}" PARENT_SCOPE)
    foreach(file launcher kernel setup cli)
        set(AMPIFY_FILE_${file} "${AMPIFY_FILE_${file}}" PARENT_SCOPE)
    endforeach()
endfunction()

function(ampify_write_apple_facts)
    file(READ "${AMPIFY_FACTS_DIR}/apple.json" json)
    foreach(part name publisherId appId)
        ampify_fact(AMPIFY_APPLE_${part} "${json}" package ${part})
    endforeach()
    foreach(part app agent)
        ampify_fact(AMPIFY_APPLE_PROCESS_${part} "${json}" processes ${part})
    endforeach()
    ampify_fact(AMPIFY_APPLE_PLAYER_DLL "${json}" playerDll)
    ampify_fact_list(AMPIFY_APPLE_EXPORTS "${json}" requiredPlayerExports)
    ampify_fact_list(AMPIFY_PROTECTED_NAMES "${json}" protectedModules names)
    ampify_fact_list(AMPIFY_PROTECTED_PARTS "${json}" protectedModules nameContains)
    string(JSON count LENGTH "${json}" testedBuilds)
    set(builds "")
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        ampify_fact(build "${json}" testedBuilds ${index} version)
        list(APPEND builds "\"${build}\"")
    endforeach()
    list(JOIN builds ", " AMPIFY_APPLE_BUILDS)
    configure_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/apple_facts.hpp.in" "${AMPIFY_FACTS_INCLUDE}/apple_facts.hpp" @ONLY)
endfunction()

ampify_write_release_facts()
ampify_write_apple_facts()
