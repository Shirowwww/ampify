// An element of Ampify's own. A built-in one lives in the kernel: no folder, no manifest, only its settings key. A
// first-party one may hold the permissions reserved for Ampify's own elements. A catalog one is not in the package:
// the Marketplace delivers and updates it, and one that starts on is installed from the catalog at the first start.
struct KitElement {
    std::string_view kind;    // "app" or "extension"
    std::string_view folder;  // "apps" or "extensions"
    std::string_view id;
    bool startsOn;
    bool firstParty;
    bool builtIn;
    bool catalog;
};

inline constexpr KitElement kKitElements[] = {
@AMPIFY_KIT_ELEMENTS@};

