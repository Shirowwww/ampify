// Version resource of an Ampify binary, filled in by ampify_version_resource() in CMakeLists.txt.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE @AMPIFY_RC_FILETYPE@
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Shirowwww"
            VALUE "FileDescription", "@AMPIFY_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@AMPIFY_RC_NAME@"
            VALUE "LegalCopyright", "Copyright (C) 2026 Shirowwww"
            VALUE "OriginalFilename", "@AMPIFY_RC_FILE@"
            VALUE "ProductName", "Ampify"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "Comments", "https://github.com/Shirowwww/ampify"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
